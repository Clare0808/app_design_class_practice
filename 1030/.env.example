# Server-only secrets. Never commit a populated .env file or expose these values to browser code.
# LINE Developers Console > LINE Login channel > Basic settings
LINE_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_LOGIN_CHANNEL_SECRET

# URL of the page served by server.js; register this exact callback in LINE Developers.
# Both URLs must share the same origin; run the app with `npm start`, not a static server.
LINE_REDIRECT_URI=http://localhost:5500/
APP_ORIGIN=http://localhost:5500

# Required Firebase service account details (Firebase Console > Project settings > Service accounts).
# Use the same Firebase project as index.html. Never put these keys into the HTML.
FIREBASE_PROJECT_ID=event-magagement
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

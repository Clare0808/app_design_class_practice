# Server-only secrets. Never commit a populated .env file or expose these values to browser code.
# LINE Developers Console > LINE Login channel > Basic settings
LINE_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_LOGIN_CHANNEL_SECRET

# Server-side OAuth callback and app origin; set these for your deployment.
LINE_REDIRECT_URI=http://localhost:5500/
APP_ORIGIN=http://localhost:5500

# Optional backend integration. The frontend Firebase Web config is not secret;
# keep Firebase Admin SDK credentials/private keys on the server only.
FIREBASE_PROJECT_ID=event-magagement
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
